DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/donnie_db

# Payments: LiqPay.
# demo   = built-in emulator, no keys, no real money (default).
# liqpay = real LiqPay; put the SANDBOX keys from your LiqPay account below
#          (they start with "sandbox_"), so no real money is charged.
PAYMENT_PROVIDER=demo
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Public address of the site, needed for LiqPay callbacks (not for localhost).
PUBLIC_BASE_URL=

# Payment receipts by email.
# console = nothing is sent; each letter is saved as an .eml file in ./outbox (default).
# smtp    = a real mail server, e.g. Gmail (smtp.gmail.com, port 587, an app password)
#           or Mailtrap's test inbox. Port 465 uses SSL, other ports STARTTLS.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
