DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/donnie_db

# Payments: LiqPay.
# demo   = built-in emulator, no keys, no real money (default).
# liqpay = real LiqPay; put the SANDBOX keys from your LiqPay account below
#          (they start with "sandbox_"), so no real money is charged.
PAYMENT_PROVIDER=demo
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Public address of the site, needed for LiqPay callbacks (not for localhost).
PUBLIC_BASE_URL=
